<view class="container">
  <view class="hero card anim-up">
    <view class="hero-label">本月结余</view>
    <view class="balance">{{balance}}</view>
    <view class="hero-stats">
      <view class="hs"><text class="hs-lab">收入</text><text class="hs-val inc">{{income}}</text></view>
      <view class="hs-div"></view>
      <view class="hs"><text class="hs-lab">支出</text><text class="hs-val exp">{{expense}}</text></view>
    </view>
  </view>

  <view class="quick-grid">
    <view class="q-card" bindtap="goAdd">
      <view class="q-ico">✍️</view>
      <view class="q-t">记一笔</view>
    </view>
    <view class="q-card" bindtap="goBill">
      <view class="q-ico">📒</view>
      <view class="q-t">账单</view>
    </view>
    <view class="q-card" bindtap="goStat">
      <view class="q-ico">📊</view>
      <view class="q-t">统计</view>
    </view>
  </view>

  <!-- 账户总览 + 预算进度 -->
  <view class="card overview">
    <view class="ov-row" bindtap="goAccount">
      <view class="ov-label">账户总资产</view>
      <view class="ov-value">{{accountsTotal}} 元 <text class="ov-arrow">›</text></view>
    </view>
    <view class="ov-row" bindtap="goBudget">
      <view class="ov-label">本月预算</view>
      <view class="ov-value">
        已用 {{budgetUsed}} / {{budgetTotal}}
        <text class="ov-arrow">›</text>
      </view>
    </view>
    <view class="ov-bar">
      <view class="ov-fill {{budgetOver ? 'over' : ''}}" style="width:{{budgetPct}}%"></view>
    </view>
    <view class="ov-pct {{budgetOver ? 'over' : ''}}">
      {{budgetOver ? '已超支 ' + budgetPct + '%' : '预算使用 ' + budgetPct + '%'}}
    </view>
  </view>

  <view class="card recent" wx:if="{{recent.length > 0}}">
    <view class="rec-head">最近记录</view>
    <view class="rec-item" wx:for="{{recent}}" wx:key="date">
      <text class="rec-cat">{{item.category}}{{item.cropTag ? ('·' + item.cropTag) : ''}}</text>
      <text class="rec-date">{{item.date}}</text>
      <text class="rec-amt {{item.type === 'income' ? 'inc' : 'exp'}}">{{item.type === 'income' ? '+' : ''}}{{item.amount}}</text>
    </view>
  </view>

  <view class="quick-grid">
    <view class="q-card" bindtap="goAccount">
      <view class="q-ico">🏦</view>
      <view class="q-t">账户管理</view>
    </view>
    <view class="q-card" bindtap="goBudget">
      <view class="q-ico">🔔</view>
      <view class="q-t">预算提醒</view>
    </view>
    <view class="q-card" bindtap="goExport">
      <view class="q-ico">📤</view>
      <view class="q-t">数据导出</view>
    </view>
  </view>

  <view class="card note">
    <text class="ico">🔒</text>
    <text>数据已云同步，仅本人可见</text>
  </view>

  <view class="fab" bindtap="goAdd">＋</view>
</view>
