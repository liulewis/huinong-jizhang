.page { padding: 24rpx; }
.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}
.summary {
  background: linear-gradient(135deg, #07c160, #16c47f);
  color: #fff;
}
.summary-label { font-size: 26rpx; opacity: 0.9; }
.summary-value { font-size: 56rpx; font-weight: bold; margin-top: 8rpx; }

.section-title { font-size: 28rpx; color: #666; margin: 16rpx 8rpx; }
.empty { text-align: center; color: #999; padding: 40rpx; font-size: 26rpx; }

.acc-card { display: flex; align-items: center; }
.acc-icon {
  width: 72rpx; height: 72rpx; line-height: 72rpx; text-align: center;
  font-size: 40rpx; border-radius: 16rpx; background: #f2fbf5; margin-right: 20rpx;
}
.acc-main { flex: 1; }
.acc-name { font-size: 30rpx; font-weight: 500; }
.acc-type { font-size: 24rpx; color: #999; margin-top: 4rpx; }
.acc-month { font-size: 22rpx; color: #07c160; margin-top: 6rpx; }
.acc-balance { font-size: 32rpx; font-weight: bold; color: #07c160; margin-right: 16rpx; }
.acc-ops { display: flex; flex-direction: column; align-items: flex-end; }
.acc-ops .op { font-size: 24rpx; color: #07c160; padding: 4rpx 0; }
.acc-ops .op.danger { color: #e64340; }

.tag-default {
  font-size: 20rpx; color: #fff; background: #07c160;
  border-radius: 8rpx; padding: 2rpx 10rpx; margin-left: 10rpx; vertical-align: middle;
}

.btn-primary {
  background: #07c160; color: #fff; border-radius: 44rpx; margin-top: 20rpx;
  font-size: 30rpx;
}
.btn-ghost {
  background: #f2f2f2; color: #333; border-radius: 44rpx; font-size: 30rpx;
}

.mask {
  position: fixed; left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(0,0,0,0.4); display: flex; align-items: flex-end; z-index: 100;
}
.sheet {
  background: #fff; width: 100%; border-radius: 28rpx 28rpx 0 0; padding: 32rpx; box-sizing: border-box;
}
.sheet-title { font-size: 32rpx; font-weight: bold; text-align: center; margin-bottom: 24rpx; }
.field { display: flex; align-items: center; padding: 18rpx 0; border-bottom: 1rpx solid #f0f0f0; }
.label { width: 200rpx; font-size: 28rpx; color: #333; }
.input { flex: 1; font-size: 28rpx; text-align: right; }
.picker { flex: 1; text-align: right; font-size: 28rpx; color: #07c160; }
.sheet-actions { display: flex; gap: 20rpx; margin-top: 32rpx; }
.sheet-actions button { flex: 1; }
