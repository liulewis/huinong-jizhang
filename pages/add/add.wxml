<view class="container">
  <view class="typebar">
    <view class="type {{type==='expense'?'active':''}}" data-type="expense" bindtap="switchType">支出</view>
    <view class="type {{type==='income'?'active':''}}" data-type="income" bindtap="switchType">收入</view>
  </view>

  <view class="field">
    <text class="label">分类</text>
    <view class="cat-right">
      <picker mode="selector" range="{{categories}}" bindchange="onCategory">
        <view class="picker">{{category || '请选择'}}</view>
      </picker>
      <text class="manage" bindtap="manageCategory">管理</text>
    </view>
  </view>

  <view class="field amount">
    <text class="label">金额</text>
    <input class="input" type="digit" placeholder="0.00" value="{{amount}}" bindinput="onAmount" />
  </view>

  <view class="field">
    <text class="label">账户</text>
    <picker mode="selector" range="{{accounts}}" value="{{accountIndex}}" bindchange="onAccount">
      <view class="picker">{{account || '默认账户'}}</view>
    </picker>
  </view>

  <view class="field">
    <text class="label">日期</text>
    <picker mode="date" value="{{date}}" bindchange="onDate">
      <view class="picker">{{date}}</view>
    </picker>
  </view>

  <view class="field">
    <text class="label">备注</text>
    <input class="input" placeholder="选填" value="{{note}}" bindinput="onNote" />
  </view>

  <view class="field col">
    <text class="label">作物/地块</text>
    <input class="input" placeholder="选填，如：1号棚番茄" value="{{cropTag}}" bindinput="onCrop" />
  </view>

  <view wx:if="{{cropSuggest.length > 0}}" class="suggest">
    <text class="suggest-tip">历史作物：</text>
    <view wx:for="{{cropSuggest}}" wx:key="*this" class="chip" data-crop="{{item}}" bindtap="pickCrop">{{item}}</view>
  </view>

  <button class="primary" bindtap="save">保存</button>
</view>
