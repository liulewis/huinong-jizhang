.page { padding: 24rpx; }
.card {
  background: #fff; border-radius: 20rpx; padding: 24rpx;
  margin-bottom: 20rpx; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}
.row-between { display: flex; justify-content: space-between; align-items: center; }
.title { font-size: 30rpx; font-weight: bold; }
.edit { font-size: 26rpx; color: #07c160; }
.big { font-size: 32rpx; margin: 20rpx 0 16rpx; color: #333; }
.bar { height: 16rpx; background: #eee; border-radius: 10rpx; overflow: hidden; }
.bar-fill { height: 100%; background: #07c160; border-radius: 10rpx; transition: width .3s; }
.bar-fill.over { background: #e64340; }
.pct { font-size: 24rpx; color: #07c160; margin-top: 10rpx; }
.pct.over-text, .over-text { color: #e64340; }

.section-title { font-size: 28rpx; color: #666; margin: 16rpx 8rpx; }
.empty { text-align: center; color: #999; padding: 30rpx; font-size: 26rpx; }

.cat-card .cat-head { display: flex; justify-content: space-between; align-items: center; }
.cat-name { font-size: 28rpx; font-weight: 500; }
.cat-used { font-size: 22rpx; color: #999; }
.cat-edit { display: flex; align-items: center; margin-top: 16rpx; }
.cat-edit .label { font-size: 26rpx; color: #666; margin-right: 16rpx; }
.mini-input {
  flex: 1; text-align: right; border: 1rpx solid #e5e5e5; border-radius: 10rpx;
  padding: 8rpx 16rpx; font-size: 26rpx;
}

.btn-primary { background: #07c160; color: #fff; border-radius: 44rpx; margin-top: 20rpx; font-size: 30rpx; }
.btn-ghost { background: #f2f2f2; color: #333; border-radius: 44rpx; font-size: 30rpx; }

.mask {
  position: fixed; left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(0,0,0,0.4); display: flex; align-items: flex-end; z-index: 100;
}
.sheet { background: #fff; width: 100%; border-radius: 28rpx 28rpx 0 0; padding: 32rpx; box-sizing: border-box; }
.sheet-title { font-size: 32rpx; font-weight: bold; text-align: center; margin-bottom: 24rpx; }
.field { display: flex; align-items: center; padding: 18rpx 0; border-bottom: 1rpx solid #f0f0f0; }
.label { width: 280rpx; font-size: 28rpx; color: #333; }
.input { flex: 1; font-size: 28rpx; text-align: right; }
.sheet-actions { display: flex; gap: 20rpx; margin-top: 32rpx; }
.sheet-actions button { flex: 1; }
